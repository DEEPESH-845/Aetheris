            contentStyle={{ backgroundColor: '#020205', borderColor: 'rgba(0, 243, 255, 0.3)', borderRadius: '4px' }}
            itemStyle={{ color: '#00f3ff' }}
            labelStyle={{ display: 'none' }}
          />
          <Area 
